APP_NAME=Bordro AI
APP_ENV=development
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://bordro_user:CHANGE_ME@localhost:5432/bordro_db

# Authentication (replace every placeholder outside disposable local demos)
AUTH_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_COOKIE_NAME=bordro_refresh
# Local HTTP only. Production configuration is rejected unless this is true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth

# Per-process MVP login throttling. See frontend/README.md for deployment limits.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_COOLDOWN_SECONDS=900

# Used only by the idempotent development/demo seed.
DEMO_AUTH_PASSWORD=CHANGE_ME_DEVELOPMENT_ONLY

# Explicit comma-separated browser origins; wildcards are ignored.
CORS_ORIGINS=http://localhost:5173
