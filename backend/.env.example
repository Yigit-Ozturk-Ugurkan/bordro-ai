APP_NAME=Bordro AI
APP_ENV=development
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://bordro_user:CHANGE_ME@localhost:5432/bordro_db

# Authentication (replace every placeholder outside disposable local demos)
AUTH_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_COOKIE_NAME=bordro_refresh
# Local HTTP only. Production configuration is rejected unless this is true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth

# Per-process MVP login throttling. See frontend/README.md for deployment limits.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_COOLDOWN_SECONDS=900

# Used only by the idempotent development/demo seed.
DEMO_AUTH_PASSWORD=CHANGE_ME_DEVELOPMENT_ONLY

# Explicit comma-separated browser origins; wildcards are ignored.
CORS_ORIGINS=http://localhost:5173

# Durable payroll-import document storage. Development defaults under the
# ignored backend/runtime directory; production should use a dedicated,
# protected filesystem path outside the repository and all static assets.
PAYROLL_DOCUMENT_STORAGE_ROOT=runtime/payroll-documents
PAYROLL_DOCUMENT_MAX_UPLOAD_BYTES=26214400

# Private General Reader server-to-server integration. No real secret belongs
# in source control. The shared secret must contain at least 32 UTF-8 bytes.
GENERAL_READER_BASE_URL=http://127.0.0.1:8010
GENERAL_READER_CLIENT_ID=
GENERAL_READER_SHARED_SECRET=
GENERAL_READER_TIMEOUT_SECONDS=180
GENERAL_READER_ALLOW_LLM=false
